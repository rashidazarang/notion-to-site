{
  "name": "ntx",
  "version": "0.1.0",
  "description": "Notion to X — sync any Notion database to markdown, MDX, or JSON",
  "type": "module",
  "bin": {
    "ntx": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },

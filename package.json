{
  "name": "notion-to-site",
  "version": "0.7.0",
  "description": "Sync any Notion database to static markdown, MDX, or JSON files",
  "type": "module",
  "bin": {
    "nts": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "notion",
    "cms",
    "markdown",
    "mdx",
    "static-site",
    "blog",
    "sync"
  ],
  "author": "Rashid Azarang",
  "license": "MIT",
  "homepage": "https://github.com/rashidazarang/notion-to-site",
  "repository": {
    "type": "git",
    "url": "https://github.com/rashidazarang/notion-to-site.git"
  },
  "bugs": {
    "url": "https://github.com/rashidazarang/notion-to-site/issues"
  },
  "dependencies": {
    "@notionhq/client": "^5.20.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "notion-to-md": "^3.1.9",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}

  ],
  "license": "MIT",
  "dependencies": {
    "@notionhq/client": "^5.20.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "notion-to-md": "^3.1.9",
    "ora": "^9.4.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}

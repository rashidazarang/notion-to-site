Action (full sync pipeline):
```typescript
const config = await loadConfig()
const outputDir = path.resolve(config.output)
const state = loadState(outputDir)
const client = new NotionClient()
const renderer = new NtxRenderer(client)

// Pick adapter
const adapter = config.adapter === 'mdx'
  ? new MdxAdapter()
  : config.adapter === 'json'
  ? new JsonAdapter()
  : new MarkdownAdapter()

const databaseId = opts.db ?? config.database
let synced = 0, skipped = 0
const startTime = Date.now()

for await (const page of client.paginateDatabase(databaseId)) {
  const props = extractProperties(page)
  if (!props.title) continue

  const slug = slugify(props.title)
  if (!slug) continue

  // Incremental check
  if (opts.incremental && !needsUpdate(state, page.id, page.last_edited_time)) {
    skipped++
    continue
  }

  const spinner = ora(`Syncing ${slug}...`).start()

  try {
    // Render markdown
    let content = await renderer.renderPage(page.id)

    // Resolve image placeholders
    if (config.images.download) {
      const imageDir = path.resolve(config.images.outputDir)
      content = await resolveImagePlaceholders(content, slug, imageDir, config.images.quality)
    }

    // Auto-enrich
    const language = props.language || detectLanguage(content)
    const comment = extractComment(content, props.title)

    // Build frontmatter
    const today = new Date().toISOString().split('T')[0]
    const frontmatter: PostFrontmatter = {
      id: slug,
      path: `/blog/${slug}.md`,
      type: 'essay',
      intent: 'reference',
      version: '1.0',
      created: today,
      last_updated: today,
      source: { platform: 'notion', page_id: page.id },
      meta: {
        title: props.title,
        author: 'Rashid Azarang',
        category: [],
        main_tag: null,
        tags: props.tags,
        featured: props.featured,
        featured_at: props.featured_at,
        language,
        post_type: 'Post',
        status: props.status,
        comment,
        cover_image: props.cover_image,
      },
    }

    // Validate if strict mode
    if (config.schema.strict) {
      validateFrontmatter(frontmatter)
    }

    // Write
    adapter.write(slug, frontmatter, content, outputDir)

    // Update state
    const newState = updatePageState(state, {
      pageId: page.id,
      slug,
      lastEditedTime: page.last_edited_time,
      outputPath: path.join(outputDir, slug + '.md'),
      imageHashes: {},
    })
    Object.assign(state, newState)

    spinner.succeed(chalk.green(`✓ ${slug}`))
    synced++
  } catch (err: any) {
    spinner.fail(chalk.red(`✗ ${slug}: ${err.message}`))
  }
}

// Update lastFullSync if not incremental
if (!opts.incremental) {
  state.lastFullSync = new Date().toISOString()
}
saveState(outputDir, state)

const elapsed = ((Date.now() - startTime) / 1000).toFixed(1)
console.log(chalk.blue(`\nSynced ${synced} pages (${skipped} skipped) in ${elapsed}s`))
```

Helper function `slugify(title: string): string`:
```typescript
function slugify(title: string): string {
  return title
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim()
}
```

Helper function `resolveImagePlaceholders`:
```typescript
async function resolveImagePlaceholders(
  content: string,
  slug: string,
  imageDir: string,
  quality: number = 80
): Promise<string> {
  // Find all `![image](notion:{blockId})` patterns
  // For each: we can't resolve the actual URL from blockId alone in this step
  // Instead: strip the placeholder (Notion image blocks are fetched with actual URLs in the renderer)
  // This is a known limitation of v0.1.0 — image URLs must come from renderer, not block IDs
  return content.replace(/!\[image\]\(notion:[^)]+\)/g, '')
}
```

Note: Image resolution from placeholders is a v0.2.0 feature. For v0.1.0, strip placeholders
since actual image URLs must be captured during rendering (not from block IDs alone). The
renderer should be updated in a future step to capture URLs during rendering instead of
emitting block ID placeholders.

